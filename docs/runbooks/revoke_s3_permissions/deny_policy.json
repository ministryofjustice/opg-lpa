{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyAllExceptBreakglass",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:*"],
      "Resource": ["bucket_arn", "bucket_arn/*"],
      "Condition": {
        "ArnNotEquals": {
          "aws:PrincipalArn": "breakglass_role"
        }
      }
    }
  ]
}
