<!DOCTYPE html>
<html lang="en">
<head>
  <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
  {% if refreshUrl %}    <meta http-equiv="refresh" content="2;url={{ refreshUrl }}">
  {% endif %}
  <title>Generating your document | GOV.UK</title>

  <link href="{{ '/assets/v2/css/download-message.css' | asset_path({ 'minify':true }) }}" media="all" rel="stylesheet" type="text/css" />
</head>
<body>

<div class="download-message">
  {% if refreshUrl %}
    <h2>Please wait while we generate your document. It will appear here in a few seconds.</h2>
  {% else %}
    <h2>Your document is taking longer than usual to generate.</h2>
    <p>It may still be in progress. <a href="{{ retryUrl }}">Check again</a>.</p>
  {% endif %}
</div>
</body>
</html>
