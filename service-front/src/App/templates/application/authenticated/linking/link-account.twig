{% import "application/macros.twig" as macros %}
{% extends 'layout/layout.twig' %}

{%- set pageTitle = 'Link your Make account to this OneLogin account' -%}
{% block mainTitle %}{% endblock mainTitle %}

{# Set form fields variables #}
{% set email = form.get('email') %}
{% set password = form.get('password') %}

{% set form = formErrorTextExchange(form, {
    'email': {
        'cannot-be-empty': 'Enter your email address',
    },
    'password' : {
        'cannot-be-empty' : 'Enter your password'
    }
}) %}

{% block content %}
  <div class="govuk-grid-row govuk-!-margin-top-9">
      {% if authError %}
          <div class="govuk-error-summary govuk-!-margin-top-6" role="alert" aria-labelledby="error-heading" tabindex="-1" data-cy="error-summary" data-module="govuk-error-summary">
              <h2 class="govuk-error-summary__title" id="error-heading" data-cy="error-heading">There is a problem</h2>
              <div class="govuk-error-summary__body" data-tracking-context="Linking account">
                  {% if authError == 'api-error' %}
                      <p class="govuk-body" data-cy="link-account-error">Sorry, the service is unavailable. Please try again later.</p>
                  {% elseif authError == 'not-activated' %}
                      <p class="govuk-body" data-cy="link-account-error">Your account has not been activated. Click on the link in the email sent to you when you created the account.
                          If you have not received an email, check your spam, bulk or junk email folder or <a class="govuk-link" href="{{ url('register/resend-email') }}">resend activation email</a>.</p>
                  {% elseif authError == 'locked' %}
                      <p class="govuk-body" data-cy="link-account-error">This user account has been locked. Please go <a class="govuk-link" href="{{ url('forgot-password') }}">here</a> to reset your password OR you can attempt again in 15 minutes.</p>
                  {% elseif authError == 'link-failed' %}
                      <p class="govuk-body" data-cy="link-account-error">Email address and password combination not recognised. Please try again.</p>
                  {% endif %}
              </div>
          </div>
      {% endif %}

      {{ macros.formErrorSummary(error, form) }}

    <div class="govuk-grid-column-two-thirds">
      {{ email.setAttributes({
        id: 'email',
        class: 'govuk-input',
        'data-cy': 'login-email'
      }) ? ''}}

      {{ password.setAttributes({
        id: 'password',
        class: 'govuk-input',
        'data-cy': 'login-password'
      }) ? '' }}

      {{ email.setOptions({ label: 'Email address' }) ? '' }}

      {{ form.prepare() ? '' }}
      {{ form().openTag( form )|raw }}
      <input type="hidden" name="__csrf" value="{{ csrfToken }}">

      <h1 class="govuk-heading-xl">Link your Make account to this One Login account</h1>

      {{ macros.formGroup2(email) }}

      <div class="govuk-form-group {{ password.getMessages|length >0 ? 'govuk-form-group--error'}}">
        <label class="govuk-label" for="{{ password.getAttribute('id') }}">Password</label>
        {{ formElementErrorsV2(password) }}
        {{ formElement(password) }}
        <div>
          <a href="#" class="hidden js-showHidePassword govuk-link" data-for="password">Show password</a>
        </div>
      </div>

    <button type="submit" class="govuk-button" data-cy="link-account-submit">Sign in</button>

      {{ form().closeTag|raw }}

      <p class="govuk-body">
        <a class="govuk-link" href="{{ url('forgot-password') }}" data-cy="link-account-forgot-password">Forgotten your password?</a>
      </p>
    </div>
  </div>
{% endblock content %}
