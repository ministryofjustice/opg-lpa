{#
  The name, date of birth and address fields of the AboutYou form, shared by /user/about-you
  and the One Login onboarding "Your details" page. Expects: form, sharedSpacesEnabled (optional),
  addressFieldsFirst (optional: show the address fields straight away, with postcode search behind a link),
  updatingDetails (optional: the One Login "Your details" page, with short headings and no shared space inset).
#}
{% import "application/macros.twig" as macros %}

{% set updatingDetails = updatingDetails|default(false) %}

{# Set form fields variables #}
{% set title = form.get('name-title') %}
{% set firstName = form.get('name-first') %}
{% set lastName = form.get('name-last') %}
{% set dob = form.get('dob-date') %}
{% set dayOfBirth = dob.get('day') %}
{% set monthOfBirth = dob.get('month') %}
{% set yearOfBirth = dob.get('year') %}
{% set address1 = form.get('address-address1') %}
{% set address2 = form.get('address-address2') %}
{% set address3 = form.get('address-address3') %}
{% set postcode = form.get('address-postcode') %}

{# form fields config #}
{{ title.setAttributes({
  id: 'name-title',
  class: 'govuk-input govuk-!-width-one-half',
  'data-cy': 'name-title',
}) ? ''}}

{{ firstName.setAttributes({
  id: 'name-first',
  class: 'govuk-input',
  'data-cy': 'name-first',
}) ? '' }}

{{ lastName.setAttributes({
  id: 'name-last',
  class: 'govuk-input',
  'data-cy': 'name-last',
}) ? '' }}

{{ dayOfBirth.setAttributes({
  id: 'dob-date-day',
  type: 'text',
  class: 'govuk-input govuk-input--width-2',
  maxlength: '2',
  pattern: '[0-9]*',
  'data-cy': 'dob-date-day',
  inputmode: 'numeric'
}) ? ''}}

{{ monthOfBirth.setAttributes({
  id: 'dob-date-month',
  type: 'text',
  class: 'govuk-input govuk-input--width-2',
  maxlength: '2',
  pattern: '[0-9]*',
  'data-cy': 'dob-date-month',
  inputmode: 'numeric'
}) ? ''}}

{{ yearOfBirth.setAttributes({
  id: 'dob-date-year',
  type: 'text',
  class: 'govuk-input govuk-input--width-4',
  maxlength: '4',
  pattern: '[0-9]*',
  'data-cy': 'dob-date-year',
  inputmode: 'numeric'
})  ? ''}}

{{ address1.setAttributes({
  id: 'address-address1',
  class: 'govuk-input',
  'data-cy': 'address-address1',
}) ? ''}}

{{ address2.setAttributes({
  id: 'address-address2',
  class: 'govuk-input',
  'data-cy': 'address-address2',
}) ? ''}}

{{ address3.setAttributes({
  id: 'address-address3',
  class: 'govuk-input',
  'data-cy': 'address-address3',
}) ? ''}}

{{ postcode.setAttributes({
  id: 'address-postcode',
  class: 'govuk-input',
  'data-cy': 'address-postcode',
}) ? ''}}

{# form fields labels #}
{{ address1.setOptions( {label: 'Address line 1'} ) ? '' }}
{{ address2.setOptions( {label: 'Address line 2'} ) ? '' }}
{{ address3.setOptions( {label: 'Address line 3'} ) ? '' }}
{{ postcode.setOptions( {label: 'Postcode'} ) ? '' }}
{{ title.setOptions( {label: 'Title'} ).setLabelAttributes( {id:'title-label'} ) ? '' }}
{{ firstName.setOptions( {label: 'First names'} ) ? '' }}
{{ lastName.setOptions( {label: 'Last name'} ) ? '' }}
{{ dayOfBirth.setLabel('Day') ? '' }}
{{ monthOfBirth.setLabel('Month') ? '' }}
{{ yearOfBirth.setLabel('Year') ? '' }}

<h2 class="govuk-heading-m govuk-!-margin-top-8">{{ updatingDetails ? 'Name' : 'What is your name?' }}</h2>

<fieldset>
  <legend class="govuk-visually-hidden">Name</legend>

  {{ macros.formGroup(title) }}
  {{ macros.formGroup(firstName) }}
  {{ macros.formGroup(lastName) }}

</fieldset>

{% if sharedSpacesEnabled|default(false) and not updatingDetails %}
  <div class="govuk-inset-text">
    If you belong to a shared space, your name is shown to other user’s who also belong to the shared space.
  </div>
{% endif %}

<h2 class="govuk-heading-m govuk-!-margin-top-8">{{ updatingDetails ? 'Date of birth' : 'What is your date of birth?' }}</h2>

<fieldset id="{{ dob.getAttribute('name') }}">
  <legend class="govuk-visually-hidden">Date of birth</legend>

  <div class="form-date {{ dob.getMessages|length >0 ? 'govuk-form-group--error'}}">
    <p class="govuk-hint">For example, 14 04 2008</p>

    <div class="error-group">
      {{ formElementErrorsV2(yearOfBirth) }}
      {{ formElementErrorsV2(monthOfBirth) }}
      {{ formElementErrorsV2(dayOfBirth) }}
      {{ formElementErrorsV2(dob) }}
    </div>

    <div class="govuk-form-group form-group-day {{ dob.getMessages|length > 0 ? 'govuk-form-group--error'}}">
      <label for="dob-date-day">Day</label>
      {{ formElement(dayOfBirth) }}
    </div>

    <div class="govuk-form-group form-group-month {{ dob.getMessages|length > 0 ? 'govuk-form-group--error'}}">
      <label for="dob-date-month">Month</label>
      {{ formElement(monthOfBirth) }}
    </div>

    <div class="govuk-form-group form-group-year {{ dob.getMessages|length > 0 ? 'govuk-form-group--error'}}">
      <label for="dob-date-year">Year</label>
      {{ formElement(yearOfBirth) }}
    </div>
  </div>

</fieldset>

<h2 class="govuk-heading-m govuk-!-margin-top-8">{{ updatingDetails ? 'Address' : 'What is your address?' }}</h2>

<fieldset class="js-PostcodeLookup" data-showerrorbar="true"{% if addressFieldsFirst|default(false) %} data-showfieldsfirst="true"{% endif %}>
  <legend class="govuk-visually-hidden">Address</legend>

  <div class="js-PostcodeLookup__postal-add">
    {{ macros.formGroup(address1) }}
    {{ macros.formGroup(address2) }}
    {{ macros.formGroup(address3) }}
    {{ macros.formGroup(postcode) }}
  </div>

</fieldset>
