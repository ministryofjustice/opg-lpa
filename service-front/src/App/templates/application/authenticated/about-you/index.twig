{% extends 'layout/layout.twig' %}

{% block errorSummary %}
    {% include 'application/authenticated/about-you/partials/form-error-summary.twig' %}
{% endblock %}

{%- set pageTitle = 'Your details' -%}

{% block content %}

{% import "application/macros.twig" as macros %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if (isNew) %}
      <div class="govuk-body">
        <p class="govuk-body">First, give us some information about yourself.</p>
        <p class="govuk-body">You do not have to be the person the LPA is for – you might just be helping someone else make an LPA.</p>
        <p class="govuk-body">You'll be able to use these details in any LPAs you make using this service.</p>
      </div>
    {% elseif not (oneLoginEnabled) %}
      <p class="govuk-body">Update your details.</p>

      <p class="govuk-body"><a class="govuk-link" href="{{ url('user/change-password') }}">Change Password</a></p>
      <p class="govuk-body"><a class="govuk-link" href="{{ url('user/change-email-address') }}">Change Email Address</a></p>
    {% endif %}

    {# begin form #}
    {{ form.prepare() ? '' }}
    {{ form().openTag( form )|raw }}
    <input type="hidden" name="__csrf" value="{{ csrfToken }}">

    {% if (oneLoginEnabled) %}
      <details class="govuk-details">
        <summary class="govuk-details__summary">
          <span class="govuk-details__summary-text">How can I change my email address or password?</span>
        </summary>
        <div class="govuk-details__text">
          Your email address and password is managed via GOV.UK One Login. If you want to make changes to either then go to your GOV.UK One Login.
        </div>
      </details>
    {% endif %}

    {% include 'application/authenticated/about-you/partials/details-fields.twig' %}

    <div class="govuk-button-group">
      <button type="submit" name="save" id="save" data-cy="save" class="govuk-button">Save and continue</button>
      {%- if not isNew -%}
        <a href="{{ cancelUrl }}" class="govuk-button govuk-button--secondary js-cancel" data-cy="form-cancel">Cancel</a>
      {%- endif -%}
    </div>

    {{ form().closeTag|raw }}

    <p class="govuk-body"><a class="govuk-link govuk-link--no-visited-state" href="{{ url('user/delete') }}">Delete Account</a></p>
  </div>
</div>
{% endblock content %}
