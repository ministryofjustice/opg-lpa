{% extends 'layout/layout.twig' %}

{% block errorSummary %}
    {% include 'application/authenticated/about-you/partials/form-error-summary.twig' %}
{% endblock %}

{%- set pageTitle = 'Your details' -%}
{%- set updatingDetails = oneLoginEnabled and not isNew -%}

{% block content %}

{% import "application/macros.twig" as macros %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if (isNew) %}
      <div class="govuk-body">
        <p class="govuk-body">First, give us some information about yourself.</p>
        <p class="govuk-body">You do not have to be the person the LPA is for – you might just be helping someone else make an LPA.</p>
        <p class="govuk-body">You'll be able to use these details in any LPAs you make using this service.</p>
      </div>
    {% elseif not (oneLoginEnabled) %}
      <p class="govuk-body">Update your details.</p>

      <p class="govuk-body"><a class="govuk-link" href="{{ url('user/change-password') }}">Change Password</a></p>
      <p class="govuk-body"><a class="govuk-link" href="{{ url('user/change-email-address') }}">Change Email Address</a></p>
    {% endif %}

    {# begin form #}
    {{ form.prepare() ? '' }}
    {{ form().openTag( form )|raw }}
    <input type="hidden" name="__csrf" value="{{ csrfToken }}">

    {% if (oneLoginEnabled) %}
      <details class="govuk-details">
        <summary class="govuk-details__summary">
          <span class="govuk-details__summary-text">Changing your sign-in details</span>
        </summary>
        <div class="govuk-details__text">
          <p class="govuk-body">You use GOV.UK One Login to sign in to the Make a lasting power of attorney service.</p>
          <p class="govuk-body">You can change these details in your GOV.UK One Login:</p>
          <ul class="govuk-list govuk-list--bullet">
            <li>email address</li>
            <li>password</li>
            <li>how you get security codes to sign in</li>
          </ul>
          <p class="govuk-body">Change your sign-in details in your <a class="govuk-link" href="https://home.account.gov.uk" target="_blank" rel="noopener noreferrer">GOV.UK One Login (opens in a new tab)</a>.</p>
        </div>
      </details>
    {% endif %}

    {% include 'application/authenticated/about-you/partials/details-fields.twig' with { updatingDetails: updatingDetails } %}

    <div class="govuk-button-group">
      <button type="submit" name="save" id="save" data-cy="save" class="govuk-button">{{ updatingDetails ? 'Save' : 'Save and continue' }}</button>
      {%- if not isNew -%}
        <a href="{{ cancelUrl }}" class="govuk-button govuk-button--secondary js-cancel" data-cy="form-cancel">Cancel</a>
      {%- endif -%}
    </div>

    {{ form().closeTag|raw }}

    <p class="govuk-body"><a class="govuk-link govuk-link--no-visited-state" href="{{ url('user/delete') }}">{{ oneLoginEnabled ? 'Deleting your account - find out more' : 'Delete Account' }}</a></p>
  </div>
</div>
{% endblock content %}
