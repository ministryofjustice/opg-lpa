{% import "application/macros.twig" as macros %}
{% extends 'layout/layout.twig' %}

{%- set overridePageTitle = 'Manage member - Manage members' -%}

{% set permissions = form.get('permissions') %}
{% set status = form.get('status') %}

{% block backLink %}
  <a href="{{ url('shared-space') }}" class="govuk-back-link">Back</a>
{% endblock %}

{% block content %}
    <div class="govuk-grid-row">
        {{ macros.formErrorSummary(error, form) }}

        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-xl">{{ member.name.first ~ ' ' ~ member.name.last }}</h1>

            {{ form.prepare() ? '' }}
            {{ form().openTag( form )|raw }}
            <input type="hidden" name="__csrf" value="{{ csrfToken }}">

            <div class="govuk-form-group {{ permissions.getMessages|length > 0 ? 'govuk-form-group--error'}}">
                <fieldset class="govuk-fieldset" aria-describedby="permissions-hint">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        Admin member
                    </legend>

                    <div id="permissions-hint" class="govuk-body">
                      Admin members, or ‘admins’, manage who is a member of the shared space and can make other members admins.
                    </div>

                    {{ formElementErrorsV2(permissions) }}

                    <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                        <div class="govuk-checkboxes__item">
                            {{ formElement(permissions) }}
                            <label class="govuk-label govuk-checkboxes__label" for="{{ permissions.getAttribute('id') }}">
                                {{ permissions.getOption('label')|raw }}
                            </label>
                        </div>

                      <div class="govuk-inset-text">
                        We recommend having more than one admin. If there’s only one admin and they leave the shared space, nobody else will be able to manage members.
                      </div>
                    </div>
                </fieldset>
            </div>

            <div class="govuk-form-group {{ status.getMessages|length > 0 ? 'govuk-form-group--error'}}">
                <fieldset class="govuk-fieldset" aria-describedby="status-hint">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        Status
                    </legend>

                    {{ formElementErrorsV2(status) }}

                    <div class="govuk-radios" data-module="govuk-radios">
                        {{ formRadio(status) }}

                        <div class="govuk-radios__conditional govuk-radios__conditional--hidden app-conditional-flush" id="conditional-suspended">
                          {% if memberActive %}
                            <div class="govuk-inset-text">
                              Selecting <strong>Suspended</strong> automatically sends an email informing them of this change.
                            </div>
                          {% endif %}
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="govuk-button-group">
                <button class="govuk-button" type="submit" data-cy="save">Save</button>
                <a class="govuk-button govuk-button--secondary" href="{{ url('shared-space') }}">Cancel</a>
            </div>

            <div class="govuk-body">
              <a class="govuk-link" href="{{ url('shared-space.members.delete', {'member-id': member.userId}) }}">Remove member - find out more</a>
            </div>

            {{ form().closeTag|raw }}
        </div>
    </div>
{% endblock content %}
