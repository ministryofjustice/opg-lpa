{% extends 'layout/layout.twig' %}

{%- set pageTitle = 'Shared space members' -%}

{% block mainTitle %}{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    {{ macros.formErrorSummary(error) }}

    <div class="govuk-grid-column-full">
      {% if inviteSuccess or revokeSuccess or memberDeleted %}
        <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
              Success
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            {% if revokeSuccess or memberDeleted %}
            <h3 class="govuk-notification-banner__heading">
              {% if revokeSuccess %}
                Invite revoked
              {% elseif memberDeleted %}
                Member deleted
              {% endif %}
            </h3>
            {% endif %}

            {% if inviteSuccess %}
              <p class="govuk-body app-full-width">
                An invite has been sent to {{ invitedMemberName }}.
              </p>
            {% endif %}
          </div>
        </div>
      {% endif %}

      <span class="govuk-caption-xl">{{ sharedSpaceName }} </span>
      <h1 class="govuk-heading-xl">{{ pageTitle }}</h1>

      {% if signedInUserIsAdmin %}
        <a href="{{ url('shared-space.invite') }}" class="govuk-button app-use-standard">Invite a member</a>

        {% if invites|length > 0 %}
          <form method="post" novalidate>
            <input type="hidden" name="__csrf" value="{{ csrfToken }}">
            <table class="govuk-table">
              <caption class="govuk-table__caption govuk-table__caption--m">Invited members</caption>
              <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                  <th scope="col" class="govuk-table__header">Name</th>
                  <th scope="col" class="govuk-table__header">Email address</th>
                  <th scope="col" class="govuk-table__header">Status</th>
                  <th scope="col" class="govuk-table__header"></th>
                </tr>
              </thead>

              {% set hasExpiredInvite = false %}
              <tbody class="govuk-table__body">
                {% for invite in invites %}
                  <tr class="govuk-table__row">
                    <td class="govuk-table__cell">
                      {{ invite.fullName }}
                    </td>
                    <td class="govuk-table__cell">{{ invite.email }}</td>
                    {% if invite.isExpired %}
                      {% set hasExpiredInvite = true %}
                      <td class="govuk-table__cell">
                        Expired
                      </td>
                      <td class="govuk-table__cell">
                        <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" name="resend" value="{{ invite.id }}">Resend invite</button>
                      </td>
                    {% else %}
                      <td class="govuk-table__cell">
                        Pending
                      </td>
                      <td class="govuk-table__cell">
                        <a class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" href="{{ url('shared-space/revoke-invite/' ~ invite.id ~ '?email=' ~ invite.email) }}">Revoke invite</a>
                      </td>
                    {% endif %}
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </form>

          {% if hasExpiredInvite %}
            <p class="govuk-body">Details of invited members with an expired status will automatically be removed after 30 days.</p>
          {% endif %}
        {% endif %}
      {% endif %}

      <table class="govuk-table">
        <caption class="govuk-table__caption govuk-table__caption--m">Members</caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Name</th>
            <th scope="col" class="govuk-table__header"></th>
            <th scope="col" class="govuk-table__header">Email address</th>
            <th scope="col" class="govuk-table__header">Status</th>
            <th scope="col" class="govuk-table__header">Last signed in</th>
          </tr>
        </thead>

        <tbody class="govuk-table__body">
          {% for member in members %}
            <tr class="govuk-table__row">
              <td class="govuk-table__cell">
                {% if member.userId === signedInUser.id %}
                  {{ member.name.first }} {{ member.name.last }} (you)
                {% else %}
                  {% if signedInUserIsAdmin %}
                    <a class="govuk-link--no-visited-state" href="{{ url('shared-space/members/' ~ member.userId) }}">
                      {{ member.name.first }} {{ member.name.last }}
                    </a>
                  {% else %}
                    {{ member.name.first }} {{ member.name.last }}
                  {% endif %}
                {% endif %}
              </td>
              <td class="govuk-table__cell">
                {% if member.isAdmin %}
                  <strong class="govuk-tag govuk-tag--green">Admin</strong>
                {% endif %}
              </td>
              <td class="govuk-table__cell">{{ member.email }}</td>
              <td class="govuk-table__cell">
                {% if member.isActive %}
                  Active
                {% else %}
                  Suspended
                {% endif %}
              </td>
              <td class="govuk-table__cell">{{ member.lastLoginAt.date|date('j F Y \\a\\t g:ia', "Europe/London") }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% endblock content %}
