{% import "application/macros.twig" as macros %}
{% extends 'layout/layout.twig' %}

{%- set pageTitle = 'Manage your Shared Space' -%}
{% block mainTitle %}{% endblock %}

{% set email = form.get('email') %}
{% set password = form.get('password') %}

{% set form = formErrorTextExchange(form, {
    'email': {
        'cannot-be-empty': 'Enter the email address',
    },
    'password' : {
        'cannot-be-empty' : 'Enter the password'
    }
}) %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if inviteSuccess or revokeSuccess or memberDeleted or importSuccess %}
        <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
              Success
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <h3 class="govuk-notification-banner__heading">
              {% if inviteSuccess %}
                Invite sent
              {% elseif revokeSuccess %}
                Invite revoked
              {% elseif memberDeleted %}
                Member deleted
              {% elseif importSuccess %}
                Import success
              {% endif %}
            </h3>
          </div>
        </div>
      {% endif %}

      {% if authError %}
        <div class="govuk-error-summary" role="alert" aria-labelledby="error-heading" tabindex="-1" data-module="govuk-error-summary">
          <h2 class="govuk-error-summary__title" id="error-heading">There is a problem</h2>
          <div class="govuk-error-summary__body">
            {% if authError == 'api-error' %}
              <p class="govuk-body">Sorry, the service is unavailable. Please try again later.</p>
            {% elseif authError == 'not-activated' %}
              <p class="govuk-body">The account has not been activated.
            {% elseif authError == 'locked' %}
              <p class="govuk-body">The account has been locked.</p>
            {% elseif authError == 'authentication-failed' %}
              <p class="govuk-body">Email address and password combination not recognised. Please try again.</p>
            {% endif %}
          </div>
        </div>
      {% endif %}

      <h1 class="govuk-heading-xl">{{ pageTitle }}</h1>

      <div class="govuk-tabs app-tabs--no-border" data-module="govuk-tabs">
        <h2 class="govuk-tabs__title">Contents</h2>

        <ul class="govuk-tabs__list" role="tablist">
          <li class="govuk-tabs__list-item govuk-tabs__list-item--selected" role="presentation">
            <a class="govuk-tabs__tab" href="#members" id="tab_members" role="tab" aria-controls="members" aria-selected="true" tabindex="0">
              Manage members
            </a>
          </li>

          <li class="govuk-tabs__list-item" role="presentation">
            <a class="govuk-tabs__tab" href="#import" id="tab_import" role="tab" aria-controls="import" aria-selected="false" tabindex="-1">
              Import LPAs from existing account
            </a>
          </li>
        </ul>

        <div class="govuk-tabs__panel" id="members" role="tabpanel" aria-labelledby="tab_members">
          {% if signedInUserIsAdmin %}
            <a href="{{ url('shared-space.invite') }}" class="govuk-button app-use-standard">Invite member</a>
          {% endif %}

          {% if invites|length > 0 %}
            <table class="govuk-table">
              <caption class="govuk-table__caption govuk-table__caption--m">Invited members</caption>
              <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                  <th scope="col" class="govuk-table__header">Name</th>
                  <th scope="col" class="govuk-table__header">Email address</th>
                  <th scope="col" class="govuk-table__header">Status</th>
                  <th scope="col" class="govuk-table__header"></th>
                </tr>
              </thead>

              <tbody class="govuk-table__body">
                {% for invite in invites %}
                  <tr class="govuk-table__row">
                    <td class="govuk-table__cell">
                      {{ invite.fullName }}
                    </td>
                    <td class="govuk-table__cell">{{ invite.email }}</td>
                    <td class="govuk-table__cell">
                      {% if invite.isExpired %}
                        Invite expired
                      {% else %}
                        Invite pending
                      {% endif %}
                    </td>
                    <td class="govuk-table__cell">
                        {% if signedInUserIsAdmin %}
                          <a class="govuk-link govuk-link--no-visited-state" href="{{ url('shared-space/revoke-invite/' ~ invite.id ~ '?email=' ~ invite.email) }}">Revoke invite</a>
                        {% endif %}
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          {% endif %}

          <table class="govuk-table">
            <caption class="govuk-table__caption govuk-table__caption--m">Members</caption>
            <thead class="govuk-table__head">
              <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Name</th>
                <th scope="col" class="govuk-table__header"></th>
                <th scope="col" class="govuk-table__header">Email address</th>
                <th scope="col" class="govuk-table__header">Status</th>
                <th scope="col" class="govuk-table__header">Last signed in</th>
              </tr>
            </thead>

            <tbody class="govuk-table__body">
              {% for member in members %}
                <tr class="govuk-table__row">
                  <td class="govuk-table__cell">
                    {% if member.userId === signedInUser.id %}
                      <a class="govuk-link--no-visited-state" href="{{ url('user/about-you') }}">
                        {{ member.name.first }} {{ member.name.last }}
                      </a> (you)
                    {% else %}
                        {% if signedInUserIsAdmin %}
                          <a class="govuk-link--no-visited-state" href="{{ url('shared-space/members/' ~ member.userId) }}">
                            {{ member.name.first }} {{ member.name.last }}
                          </a>
                        {% else %}
                            {{ member.name.first }} {{ member.name.last }}
                        {% endif %}
                    {% endif %}
                  </td>
                  <td class="govuk-table__cell">
                    {% if member.isAdmin %}
                      <strong class="govuk-tag govuk-tag--green">Admin</strong>
                    {% endif %}
                  </td>
                  <td class="govuk-table__cell">{{ member.email }}</td>
                  <td class="govuk-table__cell">
                    {% if member.isActive %}
                      Active
                    {% else %}
                      Suspended
                    {% endif %}
                  </td>
                  <td class="govuk-table__cell">{{ member.lastLoginAt.date|date('j F Y \\a\\t g:ia', "Europe/London") }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="import" role="tabpanel" aria-labelledby="tab_import">
          <p>You can import LPAs from an existing Make account. The account entered will no longer have any LPAs, and will be deleted.</p>

          {{ form.prepare() ? '' }}
          {{ form().openTag( form )|raw }}
          <input type="hidden" name="__csrf" value="{{ csrfToken }}">

          {{ macros.formGroup2(email) }}

          <div class="govuk-form-group {{ password.getMessages|length >0 ? 'govuk-form-group--error'}}">
            <label class="govuk-label" for="{{ password.getAttribute('id') }}">Password</label>
            {{ formElementErrorsV2(password) }}
            {{ formElement(password) }}
            <div>
              <a href="#" class="hidden js-showHidePassword govuk-link" data-for="password">Show password</a>
            </div>
          </div>

          <button type="submit" class="govuk-button app-use-standard">Import</button>

          {{ form().closeTag|raw }}

          <p class="govuk-body">
            <a class="govuk-link" href="{{ url('shared-space.forgot-password') }}">Forgotten your password?</a>
          </p>
        </div>
      </div>
    </div>
  </div>
{% endblock content %}
