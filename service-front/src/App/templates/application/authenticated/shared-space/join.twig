{% import "application/macros.twig" as macros %}
{% extends 'layout/layout.twig' %}

{%- set overridePageTitle = 'Join a shared space' -%}

{% set form = formErrorTextExchange(form, {
    'sharedSpaceName': {
        'isEmpty': 'Enter your shared space name',
    },
    'sharedSpaceAccessCode': {
        'isEmpty': 'Enter your joining code',
        'regexNotMatch': 'Enter a valid joining code',
    },
}) %}

{% set sharedSpaceName = form.get('sharedSpaceName') %}
{% set sharedSpaceAccessCode = form.get('sharedSpaceAccessCode') %}

{% block backLink %}
  {% if isProfessional %}
    <a href="{{ url('shared-space') }}" class="govuk-back-link">Back</a>
  {% endif %}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    {{ macros.formErrorSummary(error, form) }}

    {% if joinError %}
      <div class="govuk-error-summary" role="group" aria-labelledby="error-heading" tabindex="-1">
        <h2 class="govuk-heading-m govuk-error-summary__title" id="error-heading" data-cy="error-heading">There is a problem</h2>
        <div class="govuk-error-summary__body">
          <ul class="govuk-list govuk-error-summary__list">
            <li>{{ joinError }}</li>
          </ul>
        </div>
      </div>
    {% endif %}

    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ overridePageTitle }}</h1>

      <p class="govuk-body">You need to enter the shared space name and unique joining code. These are in the email you received, inviting you to join.</p>

      {{ form.prepare() ? '' }}
      {{ form().openTag( form )|raw }}
      <input type="hidden" name="__csrf" value="{{ csrfToken }}">

      {{ macros.formGroup2(sharedSpaceName) }}
      {{ macros.formGroup2(sharedSpaceAccessCode) }}

      <button class="govuk-button" type="submit">Join shared space</button>
      {{ form().closeTag|raw }}
    </div>
  </div>
{% endblock content %}
