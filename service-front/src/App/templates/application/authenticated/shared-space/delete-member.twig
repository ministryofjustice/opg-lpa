{% import "application/macros.twig" as macros %}
{% extends 'layout/layout.twig' %}

{%- set memberName = member.name.first ~ ' ' ~ member.name.last -%}
{%- set overridePageTitle = 'Remove user from shared space' -%}

{% block backLink %}
  <a href="{{ url('shared-space.members.manage', {'member-id': member.userId}) }}" class="govuk-back-link">Back</a>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    {{ macros.formErrorSummary(error) }}

    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Are you sure you want to remove {{ memberName }}?</h1>

      <p class="govuk-body">Removing this member from {{ member.sharedSpaceName }} means:</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>they will lose access to the lasting powers of attorney (LPAs) currently available to them in their Make an LPA account, including those they’ve worked on themselves</li>
        <li>their Make an LPA account will be deleted</li>
      </ul>

      <p class="govuk-body">Any LPAs in the shared space will still be available to its remaining members.</p>
      <p class="govuk-body">{{ memberName }}’s GOV.UK One Login will not be affected.</p>
      <p class="govuk-body">Selecting <strong>Yes, remove</strong> automatically sends an email informing them of this change.</p>

      <form novalidate method="post">
        <input type="hidden" name="__csrf" value="{{ csrfToken }}">

        <div class="govuk-button-group">
          <button class="govuk-button govuk-button--warning" type="submit" data-cy="save">Yes, remove</button>
          <a class="govuk-button govuk-button--secondary" href="{{ url('shared-space.members.manage', {'member-id': member.userId}) }}">Cancel</a>
        </div>
      </form>
    </div>
  </div>
{% endblock content %}
