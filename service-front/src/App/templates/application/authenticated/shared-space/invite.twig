{% import "application/macros.twig" as macros %}
{% extends 'layout/layout.twig' %}

{%- set pageTitle = 'Invite a member to your shared space' -%}
{% block mainTitle %}{% endblock %}

{% set firstNames = form.get('firstNames') %}
{% set lastName = form.get('lastName') %}
{% set email = form.get('email') %}
{% set permissions = form.get('permissions') %}

{% block content %}
  <div class="govuk-grid-row govuk-!-margin-top-9">
    {{ macros.formErrorSummary(error, form) }}

    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ pageTitle }}</h1>

      {{ form.prepare() ? '' }}
      {{ form().openTag( form )|raw }}
      <input type="hidden" name="__csrf" value="{{ csrfToken }}">

      {{ macros.formGroup2(firstNames) }}
      {{ macros.formGroup2(lastName) }}
      {{ macros.formGroup2(email) }}

      <div class="govuk-form-group">
        <fieldset class="govuk-fieldset" aria-describedby="permissions-hint">
          <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
            Set their permissions
          </legend>

          <div id="permissions-hint" class="govuk-hint">
            All members can create and edit LPAs.
          </div>

          <div class="govuk-checkboxes" data-module="govuk-checkboxes">
            <div class="govuk-checkboxes__item">
              <input class="govuk-checkboxes__input" id="permissions" name="{{ permissions.getName() }}" type="checkbox" value="admin" aria-describedby="permissions-item-hint" {% if permissions.isChecked() %}checked{% endif %}>
              <label class="govuk-label govuk-checkboxes__label" for="permissions">
                {{ permissions.getOption('label') }}
              </label>

              <div id="permissions-item-hint" class="govuk-hint govuk-checkboxes__hint">
                Admins can manage members and change the shared space’s details.
              </div>
            </div>
          </div>
        </fieldset>
      </div>

      <p class="govuk-body">You can change these permissions later.</p>

      <p class="govuk-body">
        When you select <strong>Send invite</strong>, we’ll send this person an
        email inviting them to join your shared space. They’ll have 48 hours to
        join.
      </p>

      <button class="govuk-button" type="submit">Send invite</button>
      {{ form().closeTag|raw }}
    </div>
  </div>
{% endblock %}
