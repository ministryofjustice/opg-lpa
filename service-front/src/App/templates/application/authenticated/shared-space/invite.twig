{% import "application/macros.twig" as macros %}
{% extends 'layout/layout.twig' %}

{%- set pageTitle = 'Invite a member to your shared space' -%}
{% block mainTitle %}{% endblock %}

{% set firstName = form.get('firstName') %}
{% set lastName = form.get('lastName') %}
{% set email = form.get('email') %}
{% set permissions = form.get('permissions') %}

{% block backLink %}
  <a href="{{ url('shared-space') }}" class="govuk-back-link">Back</a>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    {{ macros.formErrorSummary(error, form) }}

    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ pageTitle }}</h1>

      {{ form.prepare() ? '' }}
      {{ form().openTag( form )|raw }}
      <input type="hidden" name="__csrf" value="{{ csrfToken }}">

      {{ macros.formGroup2(firstName) }}
      {{ macros.formGroup2(lastName) }}
      {{ macros.formGroup2(email) }}

      <div class="govuk-form-group">
        <fieldset class="govuk-fieldset" aria-describedby="admin-hint">
          <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
            Admin member
          </legend>

          <div class="govuk-body" id="admin-hint">
            Admin members, or ‘admins’, manage who is a member of the shared space and can make other members admins.
          </div>

          <div class="govuk-checkboxes" data-module="govuk-checkboxes">
            <div class="govuk-checkboxes__item">
              {{ formElement(permissions) }}
              <label class="govuk-label govuk-checkboxes__label" for="permissions">
                {{ permissions.getOption('label') }}
              </label>
            </div>
          </div>
        </fieldset>
      </div>

      <p class="govuk-body">You can change this at any time.</p>

      <div class="govuk-inset-text">
        We recommend having more than one admin. If the only admin is no longer able to access their account, nobody else will be able to manage members.
      </div>

      <p class="govuk-body">
        Selecting <strong>Send invite</strong> automatically sends an email inviting them to join the shared space. They'll have 7 days to join.
      </p>

      <div class="govuk-button-group">
        <button class="govuk-button" type="submit">Send invite</button>
        <a class="govuk-button govuk-button--secondary" href="{{ url('shared-space') }}">Cancel</a>
      </div>
      {{ form().closeTag|raw }}
    </div>
  </div>
{% endblock %}
