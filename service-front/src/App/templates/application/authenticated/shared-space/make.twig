{% import "application/macros.twig" as macros %}
{% extends 'layout/layout.twig' %}

{%- set overridePageTitle = 'Enter the name of your shared space' -%}

{% set form = formErrorTextExchange(form, {
  'space-name': {
    'isEmpty': 'Enter your shared space name',
    'stringLengthTooLong': 'Your shared space name must be 100 characters or less',
  },
}) %}

{% set spaceName = form.get('space-name') %}

{% block backLink %}
  <a href="{{ url('shared-space') }}" class="govuk-back-link">Back</a>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    {{ macros.formErrorSummary(error, form) }}

    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ overridePageTitle }}</h1>

      {{ form.prepare() ? '' }}
      {{ form().openTag( form )|raw }}
      <input type="hidden" name="__csrf" value="{{ csrfToken }}">

      <div class="govuk-form-group {{ spaceName.getMessages|length > 0 ? 'govuk-form-group--error'}}">
        <label class="govuk-label" for="{{ spaceName.getAttribute('id') }}">
          Your shared space name
        </label>
        <div class="govuk-hint">
          For example, Alzheimer's Society or Joe Bloggs Solicitors.
        </div>

        {{ formElementErrorsV2(spaceName) }}
        {{ formElement(spaceName) }}
      </div>

      <button class="govuk-button" type="submit">Save</button>
      {{ form().closeTag|raw }}
    </div>
  </div>
{% endblock content %}
