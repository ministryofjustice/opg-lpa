{% import "application/macros.twig" as macros %}
{% extends 'layout/layout.twig' %}

{%- set overridePageTitle = 'There is no invite to join a shared space linked to your account' -%}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ overridePageTitle }}</h1>

      <p class="govuk-body">This could be because the invite has:</p>

      <ul class="govuk-list govuk-list--bullet">
        <li>expired. An invite expires after 7 days if no response is received. We delete any record of the invite after 30 days</li>
        <li>been revoked</li>
        <li>not been sent to the email address used to sign in to this account ({{email}})</li>
      </ul>

      <p class="govuk-body">
        <a class="govuk-button" href="{{ url('shared-space') }}">Return to shared space</a>
      </p>
    </div>
  </div>
{% endblock content %}
