{% extends 'layout/layout.twig' %}

{%- set overridePageTitle = 'Cannot import' -%}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ overridePageTitle }}</h1>

      <p class="govuk-body">The account you tried to import cannot be used because maybe it doesn't exist or something.</p>

      <p class="govuk-body">
        <a class="govuk-button app-use-standard" href="{{ url('shared-space') }}">Continue</a>
      </p>
    </div>
  </div>
{% endblock content %}
