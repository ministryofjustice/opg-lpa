{% extends 'layout/layout.twig' %}

{%- set overridePageTitle = oneLoginEnabled ? 'What happens if you delete your Make a lasting power of attorney account' : 'Deleting your account' -%}

{% block backLink %}
  <a href="{{ url('user/about-you') }}" class="govuk-back-link">Back</a>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ overridePageTitle }}</h1>

      {% if oneLoginEnabled %}
        {% if memberCount > 1 %}
          <p class="govuk-body">If you delete your account, you will no longer be able to access any LPAs you’ve worked on.</p>
          <p class="govuk-body">The LPAs belong to the shared space {{ sharedSpaceName }} and will still be available to its remaining members.</p>
          <p class="govuk-body">Your account details will be permanently removed from this service.</p>
        {% else %}
          <p class="govuk-body">Deleting your account will permanently remove your LPAs and personal details from this service.</p>
          <p class="govuk-body">Any completed LPAs you’ve previously downloaded or saved, or sent to OPG for registration, will not be affected.</p>
        {% endif %}
        <p class="govuk-body">Deleting your Make a lasting power of attorney account will not affect your GOV.UK One Login.</p>
      {% else %}
        <p class="govuk-body">You are about to delete your account. Doing this will permanently remove all your LPAs and personal details from our system.</p>
      {% endif %}

      <form novalidate method="post">
        <input type="hidden" name="__csrf" value="{{ csrfToken }}">

        <div class="govuk-button-group">
          {% if oneLoginEnabled %}
            <a class="govuk-button govuk-button--secondary" href="{{ url('user/about-you') }}">Return to your details</a>
            <button class="govuk-button govuk-button--warning" type="submit" data-cy="save">Delete account</button>
          {% else %}
            <button class="govuk-button govuk-button--warning" type="submit" data-cy="save">Delete account</button>
            <a class="govuk-button govuk-button--secondary" href="{{ url( 'user/dashboard' ) }}">Return to my LPAs</a>
          {% endif %}
        </div>
      </form>
    </div>
  </div>
{% endblock content %}
