{% import "application/macros.twig" as macros %}
{% extends isPopup ? 'layout/popup.twig' : 'layout/layout.twig' %}

{% block content %}
  <header class="popup-header">
    <i class="icon icon-bin"></i>
    <h2 class="govuk-heading-s govuk-!-margin-top-4 popup-header-title" id="dialog-title">
      Are you sure you want to delete this {% if isTrust %}trust corporation{% else %}person{% endif %}?
    </h2>
  </header>

  {{ macros.formErrorSummary(error, form, conflictError) }}

  <div class="form">
    <h2 class="govuk-heading-m">{{ attorneyName }}</h2>
    <p class="govuk-body">{{ attorneyAddress }}</p>

    <form method="post" action="{{ actionUrl }}" novalidate>
      <input type="hidden" name="__csrf" value="{{ csrfToken }}">
      <input type="hidden" name="version" value="{{ lpa.version }}">

      <div class="govuk-button-group app-use-standard">
        <button type="submit" class="govuk-button govuk-button--warning" data-cy="delete">Delete</button>
        <a href="{{ cancelUrl }}" data-cy="cancel" class="govuk-button govuk-button--secondary js-cancel">Cancel</a>
      </div>
    </form>
  </div>
{% endblock %}
