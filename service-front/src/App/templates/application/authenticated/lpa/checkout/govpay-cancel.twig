{% extends 'layout/layout.twig' %}

{%- set pageTitle = 'Online payment cancelled' -%}

{% block content %}

    <h2 class="govuk-heading-m govuk-!-margin-top-8 flush--top">Amount due: &pound;{{ lpa.payment.amount | money_format }}</h2>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <p class="govuk-body">You appear to have cancelled online payment. You could try paying online again or pay by cheque.</p>

        {# begin form #}
        {{ form.prepare() ? '' }}
        {{ form().openTag( form )|raw }}
        <input type="hidden" name="__csrf" value="{{ csrfToken }}">
        <input type="hidden" name="version" value="{{ lpa.version }}">

        <div class="govuk-button-group">
          <button type="submit" class="govuk-button" name="action" value="card">Retry online payment</button>
          <button class="govuk-button govuk-button--secondary" name="action" value="cheque">Pay by cheque</button>
        </div>

        {{ form().closeTag|raw }}
      </div>
    </div>

{% endblock %}
