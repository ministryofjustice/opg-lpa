{% macro navigationItem(nav, route, name, orActive = false) %}
    {% if nav.route == route or orActive %}
        <li class="govuk-service-navigation__item {{ nav.route == route ? 'govuk-service-navigation__item--active' : ''}}">
            <a class="govuk-service-navigation__link" href="{{ url(route) }}" aria-current="true">
                <strong class="govuk-service-navigation__active-fallback">{{ name }}</strong>
            </a>
        </li>
    {% else %}
        <li class="govuk-service-navigation__item">
            <a class="govuk-service-navigation__link" href="{{ url(route) }}">
                {{ name }}
            </a>
        </li>
    {% endif %}
{% endmacro %}

<section aria-label="Service information" class="govuk-service-navigation"
  data-module="govuk-service-navigation">
  <div class="govuk-width-container">
    <div class="govuk-service-navigation__container">
      <span class="govuk-service-navigation__service-name">
        <a href="/home" class="govuk-service-navigation__link">
          Make a lasting power of attorney
        </a>
      </span>
      {% if nav.userLoggedIn %}
        <nav aria-label="Menu" class="govuk-service-navigation__wrapper">
          <button type="button" class="govuk-service-navigation__toggle govuk-js-service-navigation-toggle"
            data-cy="service-nav-toggle" aria-controls="navigation" aria-expanded="false" hidden>
            Menu
          </button>
          <ul class="govuk-service-navigation__list" id="navigation" data-cy="service-nav-list">
            {% if nav.name %}
              {{ _self.navigationItem(nav, 'user/about-you', 'Your details') }}

              {{ _self.navigationItem(
                   nav,
                   nav.sharedSpaceEnabled and nav.inSharedSpace ? 'shared-space.dashboard' : 'user/dashboard',
                   nav.sharedSpaceEnabled and nav.inSharedSpace ? 'Shared LPAs' : 'Your LPAs',
                   nav.route == 'lpa-type-no-id' and nav.hasOneOrMoreLPAs == false
              ) }}
            {% endif %}

            {% if nav.sharedSpaceEnabled %}
              {{ _self.navigationItem(nav, 'shared-space', 'Shared space') }}
            {% endif %}

            <li class="govuk-service-navigation__item">
              <a class="govuk-service-navigation__link js-guidance" data-cy="guidance" href="/guide#topic-how-to-make-an-lpa-online">
                Help
              </a>
            </li>

            <li class="govuk-service-navigation__item">
              <a class="govuk-service-navigation__link" href="{{ url('application.logout') }}" data-cy="sign-out">
                Sign Out
              </a>
            </li>
          </ul>
        </nav>
      {% endif %}
    </div>
  </div>
</section>

{% if nav.lastLoginAt %}
  <div class="govuk-phase-banner govuk-width-container">
    <p class="govuk-phase-banner__content lastsigned" data-cy="last-signed-in">Last signed in: {{ nav.lastLoginAt|date('j F Y \\a\\t g:ia', "Europe/London") }}</p>
  </div>
{% endif %}
