{% extends 'layout/layout.twig' %}

{% if errorType == 'unauthorized_client' %}
  {%- set overridePageTitle = 'You are unable to sign in to this service right now' -%}
{% else %}
  {%- set overridePageTitle = 'There is a problem signing you in' -%}
{% endif %}

{% block content %}
  <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">{{ overridePageTitle }}</h1>

        {% if errorType == 'unauthorized_client' %}
          <p class="govuk-body">Please try again later.</p>

          <p class="govuk-body">If the problem persists contact <a class="govuk-link" href="https://home.account.gov.uk/contact-gov-uk-one-login">GOV.UK One Login</a></p>
        {% else %}
          <p class="govuk-body">Please try again.</p>

          <a href="{{ url('application.home') }}" role="button" draggable="false" class="govuk-button" data-module="govuk-button">
            Return to sign in
          </a>
        {% endif %}
      </div>
  </div>
{% endblock content %}
