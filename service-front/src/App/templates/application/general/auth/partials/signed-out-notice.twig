{% if isTimeout %}
    <div class="govuk-error-summary" role="group" aria-labelledby="error-heading" tabindex="-1">
      <h2 class="govuk-heading-m govuk-error-summary__title" id="error-heading" data-cy="error-heading">We’ve signed you out</h2>
      <div class="govuk-error-summary__body" data-tracking-context="Session">
          <p class="govuk-body" data-tracking-summary="Session timed out">This is because you stopped using the service or because you signed in somewhere else. Any changes you've saved will not be affected. To continue, sign in again.</p>
      </div>
    </div>
{% elseif isInternalSystemError %}
    <div class="govuk-error-summary" role="group" aria-labelledby="error-heading" tabindex="-1">
      <h2 class="govuk-heading-m govuk-error-summary__title" id="error-heading" data-cy="error-heading">There is a problem</h2>
      <div class="govuk-error-summary__body" data-tracking-context="Session">
          <p class="govuk-body" data-tracking-summary="Internal error">Sorry, the service is unavailable. Please try again later.</p>
      </div>
    </div>
{% endif %}
