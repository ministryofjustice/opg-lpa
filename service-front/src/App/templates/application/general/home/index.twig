{% extends 'layout/layout.twig' %}

{%- set pageTitle = 'Make a lasting power of attorney' -%}

{% block mainTitle %}{% endblock %}

{% block content %}
  {{ systemMessage() }}

  {% if oneLoginEnabled and not showOldHomePage %}

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">
        <div role="region" class="moj-alert moj-alert--information" aria-label="information: If you already have a registered LPA and want to use it online, go to the Use a power of attorney service" data-module="moj-alert">
          <div>
            <svg class="moj-alert__icon" role="presentation" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 30" height="30" width="30">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10.2165 3.45151C11.733 2.82332 13.3585 2.5 15 2.5C16.6415 2.5 18.267 2.82332 19.7835 3.45151C21.3001 4.07969 22.6781 5.00043 23.8388 6.16117C24.9996 7.3219 25.9203 8.69989 26.5485 10.2165C27.1767 11.733 27.5 13.3585 27.5 15C27.5 18.3152 26.183 21.4946 23.8388 23.8388C21.4946 26.183 18.3152 27.5 15 27.5C13.3585 27.5 11.733 27.1767 10.2165 26.5485C8.69989 25.9203 7.3219 24.9996 6.16117 23.8388C3.81696 21.4946 2.5 18.3152 2.5 15C2.5 11.6848 3.81696 8.50537 6.16117 6.16117C7.3219 5.00043 8.69989 4.07969 10.2165 3.45151ZM16.3574 22.4121H13.6621V12.95H16.3574V22.4121ZM13.3789 9.20898C13.3789 8.98763 13.4212 8.7793 13.5059 8.58398C13.5905 8.38216 13.7044 8.20964 13.8477 8.06641C13.9974 7.91667 14.1699 7.79948 14.3652 7.71484C14.5605 7.63021 14.7721 7.58789 15 7.58789C15.2214 7.58789 15.4297 7.63021 15.625 7.71484C15.8268 7.79948 15.9993 7.91667 16.1426 8.06641C16.2923 8.20964 16.4095 8.38216 16.4941 8.58398C16.5788 8.7793 16.6211 8.98763 16.6211 9.20898C16.6211 9.43685 16.5788 9.64844 16.4941 9.84375C16.4095 10.0391 16.2923 10.2116 16.1426 10.3613C15.9993 10.5046 15.8268 10.6185 15.625 10.7031C15.4297 10.7878 15.2214 10.8301 15 10.8301C14.7721 10.8301 14.5605 10.7878 14.3652 10.7031C14.1699 10.6185 13.9974 10.5046 13.8477 10.3613C13.7044 10.2116 13.5905 10.0391 13.5059 9.84375C13.4212 9.64844 13.3789 9.43685 13.3789 9.20898Z" fill="currentColor" />
            </svg>
          </div>
          <div class="moj-alert__content">If you already have a registered LPA and want to use it online, go to the <a href="https://www.gov.uk/manage-lasting-power-attorney/use-lasting-power-of-attorney">Use a power of attorney service</a>.</div>
        </div>
      </div>
      <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl" data-cy="main-title">{{ pageTitle }}</h1>

        <p class="govuk-body-l">This online service will help you to make a lasting power of attorney (LPA) for England and Wales.</p>

        <p class="govuk-body"><a href="{{ url("guidance", {'section': "topic-before-you-begin"}) }}" class="govuk-link js-guidance">Read more about what you’ll need when making an LPA</a>.</p>

        <h2 class="govuk-heading-l">Signing in to make a lasting power of attorney</h2>

        <p class="govuk-body">You’ll need to sign into the Make a lasting power of attorney service using GOV.UK One Login.</p>
        <p class="govuk-body">If you’ve not used GOV.UK One Login before, you can set up your access on the next page.</p>
        <p class="govuk-body">GOV.UK One Login is the new way to sign in to government services in one place, using the same email address and password.</p>

        <h2 class="govuk-heading-l">What if I have an existing Make a lasting power of attorney account?</h2>

        <p class="govuk-body">If you have a Make a lasting power of attorney account from before 25 November 2026, you can link it when you first sign in using GOV.UK One Login. This lets you carry on working on any LPAs you’ve already started making.</p>

        <div class="govuk-inset-text">
          <p class="govuk-body">By continuing, you are agreeing to the <a href="{{ url("application.terms") }}" class="govuk-link">terms of the Make a lasting power of attorney service</a>.</p>
        </div>

        <a class="govuk-button govuk-!-margin-bottom-3" href="{{ url('application.login-onelogin') }}" role="button">Continue</a>
        <p class="govuk-body govuk-!-margin-bottom-6">With GOV.UK One Login</p>

        <p class="govuk-body">If you have any problems signing in to this service, you can <a href="https://home.account.gov.uk/contact-gov-uk-one-login" class="govuk-link">contact the GOV.UK One Login team to get help</a>.</p>
      </div>
    </div>

  {% else %}
    <div class="govuk-body">
      <h1 class="govuk-heading-xl" data-cy="main-title">{{ pageTitle }}</h1>

      <p class="govuk-body-l">This online service will help you to make a lasting power of attorney
        (LPA) for England and Wales.</p>

      <p class="govuk-body">It has step-by-step <a class="govuk-link js-guidance" href="/guide#topic-what-is-an-lpa" data-analytics-click="page:link:help: lasting power of attorney" data-cy="guidance-to-making-an-lpa-link">guidance to making an LPA</a>, which will help you answer each question as you go through the service. We’ll use your answers to make an LPA that you can save and print, sign and send to the Office of the Public Guardian for registration.</p>

      <p class="govuk-body">We’ll save your LPA as you progress so you do not need to complete it in one go.</p>

      <div class="govuk-details__text">
        If you already have a registered LPA and want to use it online, go to the <a class="govuk-link" href="https://use-lasting-power-of-attorney.service.gov.uk/home" data-analytics-click="page:link:navigation: Use an LPA visit">Use a lasting power of attorney service</a>.
      </div>

      {{ systemMessage() }}
    </div>

    <div id="home-boxes">
      {% if (identity() is empty) %}
        <div id="home-boxes-left">
          <div>
            <h2 class="govuk-heading-m govuk-!-margin-top-8">I do not have an LPA account</h2>
            <p class="govuk-body">
              To start your LPA you first need to set up an online account. You can use your account
              to make multiple LPAs for yourself and others.
            </p>
            <a class="govuk-button govuk-button--start" href="{{ url('register') }}" role="button">Create my account</a>
          </div>
        </div>
        <div id="home-boxes-right">
          <div>
            <h2 class="govuk-heading-m govuk-!-margin-top-8">I already have an LPA account</h2>
            <p class="govuk-body">
              Continue making your LPA online by signing into your existing account.
            </p>
            <a class="govuk-button govuk-button--start" href="{{ url('login') }}" role="button" data-cy="sign-in-button">Sign in</a>
          </div>
        </div>
      {% else %}
        <div id="home-boxes-left">
          <div>
            <h2 class="govuk-heading-m govuk-!-margin-top-8">Make an LPA</h2>
            <p class="govuk-body">
              Begin the guided steps to make your LPA to print and sign.
            </p>
            <a class="govuk-button govuk-button--start" href="{{ url('user/dashboard/create-lpa') }}" role="button">Start now</a>
          </div>
        </div>
      {% endif %}
    </div>


    <br><br>

    <h2 class="govuk-heading-m govuk-!-margin-top-8">
      Before you make your LPA
    </h2>

    <details class="govuk-details">
      <summary class="govuk-details__summary" data-analytics-click="page:link.reveal:help: How much does it cost?">
        <span class="govuk-details__summary-text">
             How much does it cost?
        </span>
      </summary>
      <div class="govuk-details__text">
        <p class="govuk-body">
          It is free to complete your LPA online, however your LPA cannot be used until it’s registered. There’s a &pound;{{ lpaFee }} application fee to register each LPA. If the donor has an income below £12,000, or gets certain benefits, they might qualify for a lower fee, or the fee might be waived altogether. If you’re eligible for a reduction the completed form for this will be given to you at the end of this service. You can pay your application fee by card online or send a cheque with your LPA to OPG.
        </p>
        <p class="govuk-body">
          <a href="/guide#topic-fees-reductions-and-exemptions" class="govuk-link js-guidance" data-analytics-click="page:link:help: Read more about fees, reductions and exemptions">Read more about fees, reductions and exemptions</a>
        </p>
      </div>
    </details>

    <details class="govuk-details">
      <summary class="govuk-details__summary" data-analytics-click="page:link.reveal:help: What do I need to complete the form?">
        <span class="govuk-details__summary-text">
             What do I need to complete the form?
        </span>
      </summary>
      <div class="govuk-details__text">
        <ul class="govuk-list govuk-list--bullet">
          <li>name, address and date of birth of the <a href="/guide#topic-donor" class="govuk-link js-guidance" data-analytics-click="page:link:help: donor">donor</a> (the person the LPA is for)</li>
          <li>names, addresses and dates of birth of all <a href="/guide#topic-attorneys" class="govuk-link js-guidance" data-analytics-click="page:link:help: attorneys">attorneys</a>
            and <a href="/guide#topic-replacement-attorneys" class="govuk-link js-guidance"  data-analytics-click="page:link:help: replacement attorneys">replacement attorneys</a></li>
          <li>names and addresses of <a href="/guide#topic-certificate-providers" class="govuk-link js-guidance" data-analytics-click="page:link:help: certificate provider">certificate provider</a></li>
          <li>names and addresses of <a href="/guide#topic-people-to-notify" class="govuk-link js-guidance" data-analytics-click="page:link:help: people to notify">'people to notify'</a></li>
        </ul>
        <p class="govuk-body">
          You will not be asked for the name of witnesses, you can fill those in on the printed form when they sign.
        </p>
        <p class="govuk-body">
          <a href="/guide#topic-before-you-begin" class="govuk-link js-guidance" data-analytics-click="page:link:help: Read more about how to prepare">Read more about how to prepare</a>
        </p>
      </div>
    </details>

    <details class="govuk-details">
      <summary class="govuk-details__summary" data-analytics-click="page:link.reveal:help: Why can't I do all of this online?">
        <span class="govuk-details__summary-text">
            Why can’t I do all of this online?
        </span>
      </summary>
      <div class="govuk-details__text">
        <p class="govuk-body">
          For an LPA to be valid it needs to be signed and witnessed by all people mentioned on the
          LPA. The online tool makes it simpler to do the first part, the filling in of the form.
          You can take your time and can read extra help if you need it. A printed, signed LPA has to
          be registered with the Office of the Public Guardian before it can be used.
        </p>
        <p class="govuk-body">
          <a href="/guide#topic-how-to-make-an-lpa-online" class="govuk-link js-guidance" data-analytics-click="page:link:help: Read more about how to make an LPA online">Read more about how to make an LPA online</a>
        </p>
      </div>
    </details>
  {% endif %}
{% endblock %}
