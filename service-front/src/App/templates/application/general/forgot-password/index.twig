{% import "application/macros.twig" as macros %}
{% extends 'layout/layout.twig' %}

{% block errorSummary %}
  {% include 'application/partials/confirm-email-error-summary.twig' %}
{% endblock %}

{%- set pageTitle = 'Reset your password' -%}

{% set email = form.get('email') %}
{% set email_confirm = form.get('email_confirm') %}

{% block content %}
  <div class="govuk-body">
    <p class="govuk-body">Enter your email address below. If there's an account associated with the address, we'll send you a link to reset your password.</p>
  </div>

  {# begin form #}
  {{ form.prepare() ? '' }}
  {{ form().openTag( form )|raw }}
  <input type="hidden" name="__csrf" value="{{ csrfToken }}">

  <fieldset>
    <legend class="govuk-visually-hidden">Reset your password</legend>

    {{ macros.formGroup(email) }}
    {{ macros.formGroup(email_confirm) }}

    <div class="govuk-form-group">
      <input type="submit" name="submit" id="form-submit" class="govuk-button" data-cy="email-me-the-link" value="Email me the link">
    </div>

  </fieldset>

  {{ form().closeTag|raw }}

{% endblock content %}
