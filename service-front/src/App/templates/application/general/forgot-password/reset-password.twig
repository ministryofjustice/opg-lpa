{% extends 'layout/layout.twig' %}

{% block errorSummary %}
    {% include 'application/general/forgot-password/partials/reset-password-error-summary.twig' %}
{% endblock %}

{%- set pageTitle = 'Reset your password' -%}

{% block content %}

{% import "application/macros.twig" as macros %}

{# Set form fields variables #}
{% set password = form.get('password') %}
{% set password_confirm = form.get('password_confirm') %}
{% set skip_confirm_password = form.get('skip_confirm_password') %}

{# form fields config #}
{{ password.setAttributes({
    id: 'password',
    class: 'govuk-input',
    autocomplete: 'new-password',
    'data-cy': 'password'
}) ? '' }}

{{ password_confirm.setAttributes({
    id: 'password_confirm',
    class: 'govuk-input',
    autocomplete: 'new-password',
    'data-cy': 'password_confirm'
}) ? '' }}

{{ skip_confirm_password.setAttributes({
    id: 'js-skipConfirmPassword'
}) ? '' }}

{# form fields labels #}
{{ password.setOptions( {label: 'Password'} ) ? '' }}
{{ password_confirm.setOptions( {label: 'Confirm password'} ) ? '' }}

{% include 'application/partials/password-rules.twig' %}

{# begin form #}
{{ form.prepare() ? '' }}
{{ form().openTag( form )|raw }}

    <fieldset>
        <legend class="govuk-visually-hidden">Reset your password</legend>

        <div class="govuk-form-group {{ password.getMessages|length >0 ? 'govuk-form-group--error'}}">
            <label class="govuk-label" for="{{ password.getAttribute('id') }}">
                {{ password.getOption('label') }}
            </label>
            {{ formElementErrorsV2(password) }}
            {{ formElement(password) }}
            <div>
                <a href="#" class="hidden js-showHidePassword govuk-link" data-for="password" data-alsoHideConfirm="true">Show password</a>
            </div>
            {{ formElement(skip_confirm_password) }}
        </div>

        {{ macros.formGroup2(password_confirm) }}

        <div class="govuk-form-group">
            <button type="submit" id="form-submit" data-cy="reset-my-password" class="govuk-button" data-module="govuk-button">
                Reset my password
            </button>
        </div>

    </fieldset>


{{ form().closeTag()|raw }}

{% endblock content %}
